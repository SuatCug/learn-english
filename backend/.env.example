PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/english-learning-app

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — frontend origin(leri). Birden fazlaysa virgülle ayırın.
CLIENT_URL=http://localhost:5173

# Mail (doğrulama + şifre sıfırlama). GMAIL_USER ve GMAIL_APP_PASSWORD doluysa Gmail kullanılır,
# boşsa Brevo. Uygulama şifresi: Google Hesabı > Güvenlik > 2 Adımlı Doğrulama açık olmalı >
# https://myaccount.google.com/apppasswords (16 haneli, normal Gmail şifresi DEĞİL).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=learn_english

# Google ile giriş — frontend VITE_GOOGLE_CLIENT_ID ile aynı OAuth Client ID
GOOGLE_CLIENT_ID=

# Cloudinary (sadece utils/uploadTopicImages.js kullanır) — Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Piper TTS (sadece utils/generateListeningAudio.js kullanır). Varsayılan: %LOCALAPPDATA%\piper-tts
# Yol Türkçe karakter içermemeli.
# PIPER_DIR=
